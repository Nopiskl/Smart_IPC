set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(NOPISKL_SDK_PATH "$ENV{NOPISKL_SDK_PATH}" CACHE PATH "RV1106 SDK root")
if(NOT NOPISKL_SDK_PATH)
  get_filename_component(NOPISKL_SDK_PATH "${CMAKE_CURRENT_LIST_DIR}/../../../SDK/luckfox-pico" ABSOLUTE)
endif()
set(prefix "${NOPISKL_SDK_PATH}/tools/linux/toolchain/arm-rockchip830-linux-uclibcgnueabihf/bin/arm-rockchip830-linux-uclibcgnueabihf-")
set(CMAKE_C_COMPILER "${prefix}gcc")
set(CMAKE_CXX_COMPILER "${prefix}g++")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

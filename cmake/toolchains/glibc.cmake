set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(NOPISKL_GLIBC_PREFIX "$ENV{NOPISKL_GLIBC_PREFIX}" CACHE STRING "Absolute compiler prefix, e.g. /opt/arm/bin/arm-linux-gnueabihf-")
if(NOT NOPISKL_GLIBC_PREFIX)
  message(FATAL_ERROR "Set NOPISKL_GLIBC_PREFIX to a compatible ARM hard-float glibc compiler prefix")
endif()
set(CMAKE_C_COMPILER "${NOPISKL_GLIBC_PREFIX}gcc")
set(CMAKE_CXX_COMPILER "${NOPISKL_GLIBC_PREFIX}g++")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)

set(CMAKE_CXX_STANDARD 14)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_C_STANDARD 99)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
set(CMAKE_INSTALL_RPATH "$ORIGIN/lib")
option(NOPISKL_HOST_SIMULATOR "Build management/control with simulated media on the host" OFF)
option(NOPISKL_WARNINGS_AS_ERRORS "Treat warnings in project C++ targets as errors" OFF)
set(NOPISKL_LIBC "uclibc" CACHE STRING "Target runtime: uclibc or glibc")
if(NOT CMAKE_BUILD_TYPE)
  set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type" FORCE)
endif()

function(nopiskl_enable_warnings target)
  target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
  if(NOPISKL_WARNINGS_AS_ERRORS)
    target_compile_options(${target} PRIVATE -Werror)
  endif()
endfunction()

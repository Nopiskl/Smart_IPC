{
  "name": "nopiskl-smartipc-quality",
  "private": true,
  "description": "Development-only formatting and JavaScript checks; not used on the device",
  "scripts": {
    "format": "python3 scripts/check_style.py --fix",
    "format:check": "python3 scripts/check_style.py",
    "lint": "eslint apps/SmartIPC/web/app.js",
    "check:web": "node --check apps/SmartIPC/web/app.js && npm run lint"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
